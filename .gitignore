# ===== LawGate .gitignore =====

# 模型权重（本地推理用，体积巨大，不入库）
models/

# 数据库与备份（可重建，不入库）
*.db
*.bak*

# 密钥 / 环境配置（含 DeepSeek 等 API key，严禁入库）
.env
.env.*

# 临时调试 / 诊断残留（隐藏文件，非项目源码）
.diag*
.spot*
.probe*
.fix*
.vector*
.ingest*
.pip*
.sample*
.size*
.st*
.clone*
.cleanup*
.retrieval*

# Python 缓存
__pycache__/
*.pyc
.venv/

# 工作区元数据 / 缓存（本地工具数据，不入库）
.workbuddy/

# 向量库（可重建，大二进制）
data/kb/chroma/

# 临时检查 / 诊断文件（下划线前缀，非项目源码）
_*.txt
# 外部数据克隆仓库(脚本可重拉,体积过大不入库)
data/external/LawBench/
data/external/laws-data/
